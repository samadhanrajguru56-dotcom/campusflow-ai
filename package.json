{
  "name": "campusflow-ai",
  "version": "1.0.0",
  "description": "CampusFlow AI - AI-Powered Smart Campus Operations Automation Platform",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "cd client && npm run build",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "setup:db": "cd server && npm run db:setup",
    "build:client": "cd client && npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "keywords": ["hackathon", "smart-automation", "ai", "gemini", "campus-operations", "sla-tracking", "workflow-automation"],
  "author": "CampusFlow AI Team",
  "license": "MIT"
}
